# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=simlive

# Redis Configuration
REDIS_ADDR=localhost:6371

# ESPX API & Storage
ESPX_API_URL=https://api2.espx.cloud
STORAGE_BUCKET=espx-video-lib:espx-video-lib

# Rendition matching: để trống = tự động probe và ghép cặp VOD/ads cùng resolution
# (ví dụ: SIMLIVE_VOD_RENDITION=L_2, SIMLIVE_ADS_RENDITION=L0 để ép 1080p)
#SIMLIVE_VOD_RENDITION=
#SIMLIVE_ADS_RENDITION=

# Chất lượng phát: auto (mặc định - chọn cặp cao nhất) | 360p | 720p | 1080p.
# Bản test này dùng 360p (VOD L_0 + ads L2).
SIMLIVE_QUALITY=360p

# Engine Settings
TMP_DIR=./outputs
ENABLE_CLEAN_UP=false

MAX_WORKERS=50
WORKER_POOL_SIZE=50