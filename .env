# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=simlive

# Redis Configuration
REDIS_ADDR=localhost:6371

# ESPX API & Storage
ESPX_API_URL=https://api2.espx.cloud
STORAGE_BUCKET=espx-video-lib:espx-video-lib
SIMLIVE_QUALITY=360p

# Engine Settings
TMP_DIR=./tmp/simlive-go
ENABLE_CLEAN_UP=true
MAX_WORKERS=12
SIMLIVE_KEEP_BEHIND=5
AD_INSERTION_INTERVAL=300
# IS_DEV=true