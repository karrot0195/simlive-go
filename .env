# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=simlive

# Redis Configuration
REDIS_ADDR=localhost:6371

# PARTNER API & Storage
EPG_API_URL=https://api2.espx.cloud
STORAGE_BUCKET=espx-video-lib:espx-video-lib
SIMLIVE_QUALITY=360p

# Engine Settings
TMP_DIR=./tmp/simlive-go
ENABLE_CLEAN_UP=true
MAX_WORKERS=20
SIMLIVE_KEEP_BEHIND=10
AD_INSERTION_INTERVAL=300
# IS_DEV=true

# Rclone verbose mode for provider (B2) diagnostics (true/1 to enable)
# NOTE: do not use RCLONE_VERBOSE (rclone's own env var expects an int count)
SIMLIVE_RCLONE_VERBOSE=true


ACTIVE_RENDITIONS=360,720,1080
