# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=simlive

# Redis Configuration
REDIS_ADDR=localhost:6379

# Partner config (path to partner.yaml)
PARTNER_CONFIG=partner.yaml
SIMLIVE_QUALITY=360p

# Engine Settings
TMP_DIR=./tmp/simlive-go
ENABLE_CLEAN_UP=true
MAX_WORKERS=20
SIMLIVE_KEEP_BEHIND=5
SIMLIVE_DOWNLOAD_AHEAD=20
ACTIVE_RENDITIONS=360,720
PLANNER_INTERVAL=1m