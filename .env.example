# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=simlive

# Redis Configuration
REDIS_ADDR=localhost:6379

# Partner/Source API & Storage (configure for your provider)
PARTNER_API_URL=http://localhost:3030
STORAGE_BUCKET=
ADS_STREAM_ID=ads
SIMLIVE_QUALITY=360p

# Engine Settings
TMP_DIR=./tmp/simlive-go
ENABLE_CLEAN_UP=true
MAX_WORKERS=20
SIMLIVE_KEEP_BEHIND=5
SIMLIVE_DOWNLOAD_AHEAD=20
ACTIVE_RENDITIONS=360,720
PLANNER_INTERVAL=1m