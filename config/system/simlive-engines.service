[Unit]
Description=SimLive Engines Service
After=network.target simlive-planner.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/simlive-go
ExecStart=/root/simlive-go/bin/engines
Restart=always
RestartSec=10
EnvironmentFile=/root/simlive-go/.env

# Core environment variables
Environment=REDIS_ADDR=localhost:6371
Environment=DB_HOST=localhost
Environment=DB_USER=postgres
Environment=DB_PASSWORD=postgrespassword
Environment=DB_NAME=simlive
Environment=DB_PORT=5432
Environment=TMP_DIR=/root/simlive-go/outputs
Environment=SIMLIVE_QUALITY=360p
Environment=SIMLIVE_RENDITIONS=360p,720p,1080p
Environment=SIMLIVE_VOD_RENDITION=360p
Environment=SIMLIVE_ADS_RENDITION=360p
Environment=MAX_WORKERS=50
Environment=SIMLIVE_KEEP_BEHIND=5
Environment=SIMLIVE_DOWNLOAD_AHEAD=5

# Log rotation configuration

# Application-specific settings
Environment=ENABLE_CLEAN_UP=true
Environment=PLANNER_INTERVAL=5m
Environment=PLANNER_WORKERS=4
Environment=MAX_PREPARE_RETRIES=3
Environment=PREPARE_RETRY_BASE_MS=500
Environment=PREPARE_RETRY_MAX_MS=8000
Environment=RETENTION_SECONDS=7200
Environment=LOOKAHEAD_SECONDS=7200

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
